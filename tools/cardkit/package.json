{
  "name": "@cashu-card/cardkit",
  "version": "0.2.0",
  "private": true,
  "description": "Versioned Cashu Card installation and recovery API over an injected APDU transport.",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test 'gp/test/**/*.test.ts'",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "yarn build",
    "test:package": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "types": "dist/index.d.ts",
  "react-native": "index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./index.ts",
      "default": "./dist/index.js"
    },
    "./cleanup": {
      "types": "./dist/cleanup.d.ts",
      "react-native": "./cleanup.ts",
      "default": "./dist/cleanup.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "cleanup": [
        "dist/cleanup.d.ts"
      ],
      "testing": [
        "dist/testing.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "index.ts",
    "cleanup.ts",
    "testing.ts",
    "gp/*.ts",
    "testing/*.ts",
    "README.md",
    "LICENSE"
  ]
}
